# S3 target — same names as dch-core/.env. Never commit the filled-in .env.
# STORAGE_HOST: leave empty for AWS S3; set an HTTPS endpoint URL only for an
# S3-compatible service (MinIO, R2, ...).
STORAGE_HOST=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional defaults for the CLI flags of the same meaning (--source / --prefix)
# macOS:   SOURCE_DIR=/Volumes/MyDrive
# Windows: SOURCE_DIR=E:\
SOURCE_DIR=
S3_PREFIX=
