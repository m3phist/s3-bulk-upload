# S3 target — same names as dch-core/.env. Never commit the filled-in .env.
# STORAGE_HOST: leave empty for AWS S3 (region endpoint is derived); set an
# HTTPS endpoint URL only for an S3-compatible service.
STORAGE_HOST=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional defaults for the CLI flags of the same meaning (--source / --prefix)
SOURCE_DIR=/Volumes/MyDrive
S3_PREFIX=
